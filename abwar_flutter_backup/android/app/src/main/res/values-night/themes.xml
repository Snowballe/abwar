<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème sombre d'ABWAR -->
    <style name="Theme.AbwarFlutter" parent="Theme.Material3.DayNight">
        <!-- Couleurs primaires -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryDark">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        
        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorSecondaryDark">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        
        <!-- Couleurs d'accent -->
        <item name="colorAccent">@color/accent_light</item>
        <item name="colorAccentDark">@color/accent</item>
        <item name="colorAccentLight">@color/accent_dark</item>
        
        <!-- Couleurs de fond -->
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/gray_dark</item>
        <item name="colorSurfaceVariant">@color/gray</item>
        
        <!-- Couleurs de texte -->
        <item name="android:textColorPrimary">@color/text_light</item>
        <item name="android:textColorSecondary">@color/gray</item>
        <item name="android:textColor">@color/white</item>
        
        <!-- Couleurs de statut -->
        <item name="colorError">@color/error</item>
        <item name="colorWarning">@color/warning</item>
        <item name="colorSuccess">@color/success</item>
        
        <!-- Style de la barre de statut -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Style de la barre de navigation -->
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Style des boutons -->
        <item name="materialButtonStyle">@style/Widget.AbwarFlutter.Button.Dark</item>
        
        <!-- Style des cartes -->
        <item name="materialCardViewStyle">@style/Widget.AbwarFlutter.Card.Dark</item>
    </style>
    
    <!-- Style des boutons ABWAR (sombre) -->
    <style name="Widget.AbwarFlutter.Button.Dark" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">25dp</item>
        <item name="elevation">8dp</item>
    </style>
    
    <!-- Style des cartes ABWAR (sombre) -->
    <style name="Widget.AbwarFlutter.Card.Dark" parent="Widget.Material3.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">10dp</item>
        <item name="cardBackgroundColor">@color/gray_dark</item>
    </style>
    
    <!-- Style des textes ABWAR (sombre) -->
    <style name="TextAppearance.AbwarFlutter.Headline1.Dark" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.AbwarFlutter.Headline2.Dark" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.AbwarFlutter.Body1.Dark" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_light</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <style name="TextAppearance.AbwarFlutter.Body2.Dark" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/gray</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
